{
  "name": "C# Polyglot Notebooks",
  "image": "mcr.microsoft.com/devcontainers/dotnet:8.0",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    }
  },
  "containerEnv": {
    "PATH": "${containerEnv:PATH}:/home/vscode/.dotnet/tools:/root/.dotnet/tools"
  },
  "postCreateCommand": "dotnet tool install -g Microsoft.dotnet-interactive && $HOME/.dotnet/tools/dotnet-interactive jupyter install --default-kernel csharp",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.dotnet-interactive-vscode",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-keymap",
        "ms-toolsai.jupyter-renderers",
        "ms-python.python"
      ]
    }
  },
  "remoteUser": "vscode"
}
